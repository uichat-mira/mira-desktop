{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mira-push-broker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "PUSH_INSTALLATIONS",
        "class_name": "PushInstallation"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PushInstallation"]
    }
  ]
}
