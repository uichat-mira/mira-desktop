    "fastify": "^4.28.1",
    "iconv-lite": "^0.7.2",
    "imapflow": "^1.4.6",
    "jsdom": "^26.1.0",
    "jsonwebtoken": "^9.0.3",
    "langchain": "^1.4.4",
    "mailparser": "^3.9.14",
